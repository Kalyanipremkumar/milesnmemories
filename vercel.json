{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/rajasthan",
      "destination": "/travel-diaries/rajasthan/complete/",
      "permanent": true
    },
    {
      "source": "/rajasthan/",
      "destination": "/travel-diaries/rajasthan/complete/",
      "permanent": true
    }
  ]
}
